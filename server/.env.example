PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...          # storage uploads + auth admin only, never sent to the client
SUPABASE_JWT_SECRET=                   # only if the project still uses legacy HS256 JWTs

# Postgres connections (Supavisor pooler, transaction mode, port 6543)
DATABASE_URL=postgresql://app_user.<project-ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
MIGRATION_DATABASE_URL=postgresql://postgres:<pwd>@db.<project-ref>.supabase.co:5432/postgres   # migrations + seed only

# Passwords used by 001_roles_helpers.sql when migrate.js creates the DB roles
APP_USER_PASSWORD=change-me-app

# Email (nodemailer over SMTP). Gmail: turn on 2-step verification, then create an App Password.
# Leave SMTP_* empty to print invite links in the server console instead of sending mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Everest Textile Mills <you@gmail.com>"

# Network. HOST 0.0.0.0 lets a phone on the same Wi-Fi reach the API; CORS_ORIGINS adds browser origins (comma separated)
# besides CLIENT_URL. Native apps send no Origin header, so they never need CORS.
HOST=0.0.0.0
CORS_ORIGINS=

# Misc
PUBLIC_TRACK_BASE_URL=http://localhost:5173/track
# Set to false to disable cron jobs (e.g. in tests)
JOBS_ENABLED=true

# RFID attendance. The virtual scanner is a development/demo tool and is OFF unless you set this to true.
RFID_SIMULATOR_ENABLED=false
# A second scan of the same card within this many seconds is recorded as a duplicate.
RFID_DUPLICATE_WINDOW_SEC=3
# Demo scanner registered by `npm run seed:rfid` (development only). Leave the key empty and the seed generates one into
# server/.env; copy that value into the ESP32 config.h as DEVICE_KEY. Never commit a real key.
RFID_DEMO_DEVICE_ID=GATE_01
RFID_DEMO_DEVICE_KEY=
