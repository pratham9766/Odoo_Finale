{
  "name": "texlink-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node ../db/migrate.js",
    "seed": "node ../db/seed/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint src",
    "reset": "node ../db/seed/reset.js",
    "seed:rfid": "node ../db/seed/rfidDemo.js",
    "rfid:device": "node ../db/rfidDevice.js",
    "test:db": "node --test --test-concurrency=1 \"test/db/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/supabase-js": "^2.117.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nanoid": "^6.0.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
