# The API's address, without /api/v1. On a real phone use your PC's LAN IP (same Wi-Fi), not localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.100:4000
# Same values as server SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY (the public key, never the service-role key).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
