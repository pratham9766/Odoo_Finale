# REQUIRED. The API's address, without /api/v1. There is no default: the app shows a setup screen until this is set.
# On a real phone use your computer's LAN IP on the same Wi-Fi (not localhost), e.g. http://<your-ip>:4000 ; the server must listen on 0.0.0.0 (HOST).
EXPO_PUBLIC_API_URL=
# REQUIRED. Same project as the server's SUPABASE_URL, and its PUBLIC (publishable / anon) key; never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# OPTIONAL, development only. 1 = run the UI preview with built-in sample data and no server. Ignored in release builds.
EXPO_PUBLIC_PREVIEW=
